# Copy this file to .env and paste your own keys.
# Do not commit the real .env file.
#
# The app reads only the key for the provider selected in config.py.
# Choose the provider there: LLM_PROVIDER = "openai" or "gemini".

# Used when LLM_PROVIDER is "openai"
OPENAI_API_KEY=your_openai_api_key_here

# Used when LLM_PROVIDER is "gemini"
GOOGLE_API_KEY=your_google_api_key_here
